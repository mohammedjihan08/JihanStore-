{
  "entities": {
    "User": {
      "title": "User",
      "description": "Customer profile with contact and delivery details",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 128 },
        "phone": { "type": "string", "maxLength": 30 },
        "address": { "type": "string", "maxLength": 300 },
        "city": { "type": "string", "maxLength": 100 },
        "postalCode": { "type": "string", "maxLength": 20 },
        "role": { "type": "string", "enum": ["customer", "admin"] },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["uid", "name", "email", "phone", "role", "createdAt"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Authorized admin users roster",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email", "maxLength": 128 },
        "role": { "type": "string", "enum": ["admin"] },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Customer account records isolated to each user"
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Trusted admin collection determining admin privileges"
    }
  }
}
