rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net - Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'mohammedjihan08@gmail.com'
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation helper for User
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'name', 'email', 'phone', 'role', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'name', 'email', 'phone', 'address', 'city', 'postalCode', 'role', 'createdAt']) &&
        data.uid is string && data.uid.size() <= 128 &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.email is string && data.email.size() <= 128 &&
        data.phone is string && data.phone.size() <= 30 &&
        data.role in ['customer', 'admin'] &&
        data.createdAt is string && data.createdAt.size() <= 50;
    }

    // Customer Profiles Collection
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      
      // Customer registration: User can create their own profile, but cannot self-assign 'admin' role
      allow create: if isValidId(userId) && isOwner(userId) &&
        isValidUser(incoming()) &&
        incoming().uid == request.auth.uid &&
        incoming().role == 'customer';

      // Customer update: Cannot change their role or uid
      allow update: if isValidId(userId) && isOwner(userId) &&
        isValidUser(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().role == existing().role &&
        incoming().createdAt == existing().createdAt;

      allow delete: if isValidId(userId) && isAdmin();
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read, write: if isValidId(adminId) && isAdmin();
    }

    // Website & Store Settings (Publicly readable contact/payment details, Admin writeable)
    match /settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if request.query.limit <= 20;
      allow write: if isValidId(settingId) && isAdmin();
    }
  }
}
